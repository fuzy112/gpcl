@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set_and_check(GPCL_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@/cmake/gpcl")
list(APPEND CMAKE_MODULE_PATH "${GPCL_DIR}")

if(@GPCL_BFD@)
find_dependency(BFD)
endif()
if(@GPCL_LLVM@)
find_dependency(LLVM)
endif()
find_dependency(Threads)
find_dependency(Backtrace)
if(@GPCL_SQLITE@)
find_dependency(SQLite3)
endif()
include("${GPCL_DIR}/gpcl-targets.cmake")

list(POP_BACK CMAKE_MODULE_PATH)

check_required_components(gpcl)
